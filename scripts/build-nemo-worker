#!/usr/bin/env bash
set -euo pipefail
# The C++ API is source-versioned: build headers and libraries from one revision.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
REVISION=4c101bc7113f49101a3e11d2c994c519f41939f6
GGML_REVISION=c03b4e2bcece5134827881af90242086daf75be5
NATIVE=${WORDPIPE_NEMO_NATIVE:-OFF}
ITN=${WORDPIPE_NEMO_ITN:-ON}
case "$ITN" in ON|OFF) ;; *) echo "WORDPIPE_NEMO_ITN must be ON or OFF" >&2; exit 2 ;; esac
# Ship portable CPU plugins selected at runtime, not client-side compilation.
# An explicitly requested native build uses a single host-tuned CPU backend.
if [[ "$NATIVE" == ON ]]; then default_cpu_variants=OFF; else default_cpu_variants=ON; fi
CPU_VARIANTS=${WORDPIPE_NEMO_CPU_VARIANTS:-$default_cpu_variants}
case "$NATIVE" in ON|OFF) ;; *) echo "WORDPIPE_NEMO_NATIVE must be ON or OFF" >&2; exit 2 ;; esac
case "$CPU_VARIANTS" in ON|OFF) ;; *) echo "WORDPIPE_NEMO_CPU_VARIANTS must be ON or OFF" >&2; exit 2 ;; esac
if [[ "$NATIVE" == ON && "$CPU_VARIANTS" == ON ]]; then
  echo "Native compilation and portable CPU variants are mutually exclusive" >&2
  exit 2
fi
SOURCE=${WORDPIPE_NEMO_SOURCE:-$ROOT/build/nemo-speech-cpp}
UPSTREAM_BUILD=${WORDPIPE_NEMO_BUILD:-$SOURCE/build/wordpipe-cpu}
WORKER_BUILD=${WORDPIPE_NEMO_WORKER_BUILD:-$ROOT/build/nemo-worker}
if [[ ! -d "$SOURCE" ]]; then
  git clone --no-checkout https://github.com/NVIDIA/NeMo-Speech.cpp.git "$SOURCE"
  git -C "$SOURCE" checkout --detach "$REVISION"
  git -C "$SOURCE" submodule update --init --recursive
fi
if [[ "$(git -C "$SOURCE" rev-parse HEAD)" != "$REVISION" ]]; then
  echo "NeMo headers/libraries must match pinned revision $REVISION" >&2
  exit 1
fi
if [[ "$(git -C "$SOURCE/ggml" rev-parse HEAD)" != "$GGML_REVISION" ]]; then
  echo "NeMo requires its pinned ggml submodule $GGML_REVISION" >&2
  exit 1
fi
# Upstream pins stock ggml and ships required runtime extensions separately.
# Its setup script verifies the complete patch series and is safe to rerun.
bash "$SOURCE/scripts/apply-ggml-patches.sh"
# NeMo's pinned SDK links CPU/CUDA targets directly. ggml's multi-variant
# mode builds plugin modules instead, so adapt only this build/link boundary.
task_patch="$ROOT/native/wordpipe-nemo-worker/upstream-dynamic-backends.patch"
if ! git -C "$SOURCE" apply --reverse --check "$task_patch" 2>/dev/null; then
  git -C "$SOURCE" apply --check "$task_patch"
  git -C "$SOURCE" apply "$task_patch"
fi
# Always configure: a cached .so must not silently ignore changed build options.
sentencepiece_cmake=(-DSENTENCEPIECE_STATIC_LIB=OFF -USENTENCEPIECE_INCLUDE_DIR)
if [[ "$ITN" == ON ]]; then
  task_sentencepiece_prefix="$UPSTREAM_BUILD/deps/sentencepiece"
  if [[ ! -f "$task_sentencepiece_prefix/lib/libsentencepiece.a" ]]; then
    env PREFIX="$task_sentencepiece_prefix" JOBS="${WORDPIPE_BUILD_JOBS:-2}" \
      bash "$SOURCE/scripts/build_sentencepiece_static.sh" "$UPSTREAM_BUILD/deps/sentencepiece-build"
  fi
  sentencepiece_cmake=("-DSENTENCEPIECE_STATIC_LIB=$task_sentencepiece_prefix/lib/libsentencepiece.a" \
    "-DSENTENCEPIECE_INCLUDE_DIR=$task_sentencepiece_prefix/include")
  task_itn_prefix="$UPSTREAM_BUILD/deps/itn"
  if [[ ! -f "$task_itn_prefix/lib/libsparrowhawk.so" ]]; then
    env PREFIX="$task_itn_prefix" JOBS="${WORDPIPE_BUILD_JOBS:-2}" CC=gcc CXX=g++ \
      bash "$SOURCE/scripts/build_itn_deps.sh" "$UPSTREAM_BUILD/deps/itn-build"
  fi
  python3 "$ROOT/scripts/install_nemo_itn_grammars.py" "$UPSTREAM_BUILD/deps/itn_configs"
  python3 "$ROOT/scripts/export_nemo_cased_itn.py" "$UPSTREAM_BUILD/deps/text-processing" "$UPSTREAM_BUILD/deps/itn_configs/en"
fi
cmake -S "$SOURCE" -B "$UPSTREAM_BUILD" -DCMAKE_BUILD_TYPE=Release \
  "${sentencepiece_cmake[@]}" \
  -DNEMO_SPEECH_DEPENDENCY_PREFIX="$UPSTREAM_BUILD/deps" \
  -DNEMO_SPEECH_BUILD_ASR=ON -DNEMO_SPEECH_BUILD_CLI=OFF \
  -DNEMO_SPEECH_BUILD_TTS=OFF -DNEMO_SPEECH_BUILD_NMT=OFF \
  -DNEMO_SPEECH_BUILD_DIAR=OFF -DNEMO_SPEECH_BUILD_S2S=OFF -DNEMO_SPEECH_WITH_NORM="$ITN" \
  -DNEMO_SPEECH_WITH_FLASHLIGHT=OFF -DBUILD_TESTING=OFF \
  -DNEMO_SPEECH_BUILD_GRPC=OFF -DNEMO_SPEECH_BUILD_HTTP=OFF \
  -DNEMO_SPEECH_BUILD_TESTS=OFF -DNEMO_SPEECH_BUILD_TOOLS=OFF \
  -DNEMO_SPEECH_BUILD_EXAMPLES=OFF -DGGML_CUDA=OFF -DGGML_VULKAN=OFF \
  -DGGML_NATIVE="$NATIVE" -DGGML_CPU_ALL_VARIANTS="$CPU_VARIANTS" \
  -DGGML_BACKEND_DL="$CPU_VARIANTS"
cmake --build "$UPSTREAM_BUILD" --target nemo_speech_asr -j "${WORDPIPE_BUILD_JOBS:-2}"
cmake -S "$ROOT/native/wordpipe-nemo-worker" -B "$WORKER_BUILD" \
  -DCMAKE_BUILD_TYPE=Release -DNEMO_SPEECH_SOURCE_DIR="$SOURCE" \
  -DNEMO_SPEECH_LIBRARY_DIR="$UPSTREAM_BUILD/bin" \
  -DWORDPIPE_NEMO_DYNAMIC_BACKENDS="$CPU_VARIANTS" \
  -DWORDPIPE_NEMO_ITN="$ITN" -DWORDPIPE_NEMO_ITN_GRAMMAR_DIR="$UPSTREAM_BUILD/deps/itn_configs"
cmake --build "$WORKER_BUILD" -j "${WORDPIPE_BUILD_JOBS:-2}"
