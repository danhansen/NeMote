#!/usr/bin/env python3
"""Live/reloading GTK preferences preview and isolated visual audit launcher."""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
EXTENSION = ROOT / "extensions/gnome-shell/nemote@dhansen.dev"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--watch", action="store_true", help="Restart the live preview when UI sources change")
    result.add_argument("--headless", action="store_true", help="Use an isolated, software-rendered GNOME display")
    result.add_argument("--audit", action="store_true", help="Capture all preference sections and representative states; check layout")
    result.add_argument("--output", type=Path, default=ROOT / "build/ui-audit")
    result.add_argument("--scenario", choices=["ready", "multilingual", "missing", "downloading", "converting",
        "loading", "listening", "stopping", "error", "unavailable"], default="ready")
    result.add_argument("--width", type=int, default=680)
    result.add_argument("--_session", action="store_true", help=argparse.SUPPRESS)
    return result


def stop(process: subprocess.Popen | None) -> None:
    if process is None or process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)


def source_signature() -> tuple:
    paths = [*EXTENSION.glob("*.js"), *EXTENSION.glob("*.css"), *EXTENSION.glob("*.xml"),
        *EXTENSION.glob("schemas/*.xml"), *ROOT.glob("scripts/*preview*.js")]
    return tuple(sorted((str(path), path.stat().st_mtime_ns) for path in paths))


def run(args: argparse.Namespace) -> int:
    if args.watch and args.audit:
        raise SystemExit("Use --watch for interactive preview, or --audit for a finite capture run.")
    if args.width < 360:
        raise SystemExit("Preview width must be at least 360 pixels.")
    for command in ["gjs", "glib-compile-schemas"] + (["gnome-shell", "dbus-run-session"] if args.headless else []):
        if not shutil.which(command):
            raise SystemExit(f"Required tool not found: {command}")
    if args.headless and not args._session:
        return subprocess.call(["dbus-run-session", "--config-file", str(ROOT / "scripts/ui_preview_bus.conf"),
            "--", sys.executable, __file__, *sys.argv[1:], "--_session"])
    with tempfile.TemporaryDirectory(prefix="nemote-ui-preview-") as temporary:
        scratch = Path(temporary)
        schemas = scratch / "schemas"
        schemas.mkdir()
        env = dict(os.environ, GSETTINGS_BACKEND="memory", NEMOTE_UI_SCHEMA_DIR=str(schemas))
        shell = None
        child = None
        shell_log = None
        try:
            if args.headless:
                runtime = scratch / "runtime"
                runtime.mkdir(mode=0o700)
                env.update(XDG_RUNTIME_DIR=str(runtime), XDG_CONFIG_HOME=str(scratch / "config"),
                    XDG_DATA_HOME=str(scratch / "data"), XDG_CACHE_HOME=str(scratch / "cache"),
                    WAYLAND_DISPLAY="nemote-ui-preview", GDK_BACKEND="wayland", GSK_RENDERER="cairo",
                    LIBGL_ALWAYS_SOFTWARE="1", GTK_A11Y="none", GIO_USE_VFS="local", GTK_IM_MODULE="simple",
                    ADW_DISABLE_PORTAL="1")
                env.pop("DISPLAY", None)
                shell_log = (scratch / "gnome-shell.log").open("w+")
                shell = subprocess.Popen(["gnome-shell", "--headless", "--no-x11", "--virtual-monitor", "1280x1024",
                    "--wayland-display", env["WAYLAND_DISPLAY"]], env=env, stdout=shell_log, stderr=subprocess.STDOUT)
                deadline = time.monotonic() + 25
                while not (runtime / env["WAYLAND_DISPLAY"]).exists():
                    if shell.poll() is not None or time.monotonic() >= deadline:
                        shell_log.seek(0)
                        raise SystemExit("Could not start isolated GNOME display:\n" + shell_log.read())
                    time.sleep(0.1)
            elif not env.get("WAYLAND_DISPLAY") and not env.get("DISPLAY"):
                runtime = Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
                if (runtime / "wayland-0").exists():
                    env.update(WAYLAND_DISPLAY="wayland-0", GDK_BACKEND="wayland")
                else:
                    raise SystemExit("No GTK display available. Try --headless --audit.")
            command = ["gjs", "-m", str(ROOT / "scripts/preview_ui.js"),
                "--scenario", args.scenario, "--width", str(args.width)]
            if args.audit:
                args.output.mkdir(parents=True, exist_ok=True)
                command += ["--audit", str(args.output.resolve())]
            while True:
                subprocess.run(["glib-compile-schemas", "--strict", "--targetdir", str(schemas),
                    str(EXTENSION / "schemas")], check=True)
                signature = source_signature()
                child = subprocess.Popen(command, env=env)
                if not args.watch:
                    result = child.wait()
                    if result == 0 and args.audit and args.headless:
                        stop(shell)
                        env["NEMOTE_UI_AUDIT_OUTPUT"] = str(args.output.resolve())
                        shell_log.seek(0)
                        shell_log.truncate()
                        shell = subprocess.Popen(["gnome-shell", "--headless", "--no-x11", "--virtual-monitor", "1280x1024",
                            "--wayland-display", env["WAYLAND_DISPLAY"], "--automation-script",
                            str(ROOT / "scripts/preview_shell_ui.js")], env=env, stdout=shell_log, stderr=subprocess.STDOUT)
                        try:
                            result = shell.wait(timeout=45)
                        except subprocess.TimeoutExpired:
                            stop(shell)
                            result = 1
                        shell_log.seek(0)
                        log = shell_log.read()
                        shutil.copyfile(scratch / "gnome-shell.log", args.output / "compositor.log")
                        if result:
                            print(log, flush=True)
                        else:
                            print("\n".join(line for line in log.splitlines() if line.startswith("Captured Shell")), flush=True)
                            print(f"Panel gallery: {args.output / 'shell.html'}", flush=True)
                    return result
                print("Live preview running; UI edits restart it automatically. Ctrl+C to stop.", flush=True)
                while child.poll() is None and signature == source_signature():
                    time.sleep(0.25)
                if child.poll() is not None:
                    return child.returncode
                print("UI source changed; reloading…", flush=True)
                stop(child)
        finally:
            stop(child)
            stop(shell)
            if shell_log:
                shell_log.close()


if __name__ == "__main__":
    try:
        sys.exit(run(parser().parse_args()))
    except KeyboardInterrupt:
        sys.exit(130)
