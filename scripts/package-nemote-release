#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/package-nemote-release [--version VERSION] [--output-dir DIR] [--skip-build]

Build the composed NeMote GitHub release archive and the source-only GNOME
Shell extension zip suitable for extensions.gnome.org review.
EOF
}

VERSION=""
OUTPUT_DIR=""
SKIP_BUILD=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      VERSION="${2:?missing --version value}"
      shift 2
      ;;
    --output-dir)
      OUTPUT_DIR="${2:?missing --output-dir value}"
      shift 2
      ;;
    --skip-build)
      SKIP_BUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVICE_BUILD="${NEMOTE_SERVICE_BUILD:-$ROOT/build/nemote-service}"
UUID="nemote@dhansen.dev"
ARCH="$(uname -m)"

if [[ -z "$VERSION" ]]; then
  if git -C "$ROOT" describe --tags --always --dirty >/dev/null 2>&1; then
    VERSION="$(git -C "$ROOT" describe --tags --always --dirty)"
  else
    VERSION="dev"
  fi
fi

if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR="$ROOT/build/release"
fi
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR="$(cd "$OUTPUT_DIR" && pwd)"

WORK_DIR="$ROOT/build/release-work"
STAGE_ROOT="$WORK_DIR/nemote-${VERSION}-linux-${ARCH}"
EXTENSION_WORK="$WORK_DIR/${UUID}"
COMPOSED_ARCHIVE="$OUTPUT_DIR/nemote-linux-${ARCH}.tar.gz"
VERSIONED_ARCHIVE="$OUTPUT_DIR/nemote-${VERSION}-linux-${ARCH}.tar.gz"
EXTENSION_ZIP="$OUTPUT_DIR/${UUID}.shell-extension.zip"

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required tool: $1" >&2
    exit 1
  fi
}

copy_extension() {
  local destination="$1"
  rm -rf "$destination"
  mkdir -p "$(dirname "$destination")"
  cp -a "$ROOT/extensions/gnome-shell/$UUID" "$destination"
  rm -f "$destination/schemas/gschemas.compiled"
}

require_tool cmake
require_tool glib-compile-schemas
require_tool tar
require_tool zip

if [[ "$SKIP_BUILD" -eq 0 ]]; then
  bash "$ROOT/scripts/build-nemo-worker"
  bash "$ROOT/scripts/build-service"
fi

rm -rf "$WORK_DIR"
mkdir -p \
  "$STAGE_ROOT/bin" \
  "$STAGE_ROOT/lib/python" \
  "$STAGE_ROOT/share/nemote/scripts" \
  "$STAGE_ROOT/share/nemote" \
  "$STAGE_ROOT/share/dbus-1/services" \
  "$STAGE_ROOT/share/systemd/user" \
  "$STAGE_ROOT/share/gnome-shell/extensions"

cmake --install "$SERVICE_BUILD" --prefix "$STAGE_ROOT"
install -m 0755 "$ROOT/scripts/nemote-companion-install" "$STAGE_ROOT/bin/nemote-companion-install"
NEMO_WORKER_BUILD="${NEMOTE_NEMO_WORKER_BUILD:-$ROOT/build/nemote-worker}"
NEMO_SOURCE="${NEMOTE_NEMO_SOURCE:-$ROOT/build/nemo-speech-cpp}"
NEMO_BUILD="${NEMOTE_NEMO_BUILD:-$NEMO_SOURCE/build/nemote-cpu}"
cmake --install "$NEMO_WORKER_BUILD" --prefix "$STAGE_ROOT"
mkdir -p "$STAGE_ROOT/lib/nemo" "$STAGE_ROOT/share/nemote/licenses/nemo"
cp -a "$NEMO_BUILD/bin/"*.so* "$STAGE_ROOT/lib/nemo/"
if [[ "${NEMOTE_NEMO_ITN:-ON}" == ON ]]; then
  require_tool patchelf
  cp -a "$NEMO_BUILD/deps/itn_configs" "$STAGE_ROOT/share/nemote/itn"
  install -m 0644 "$NEMO_BUILD/deps/text-processing/LICENSE" "$STAGE_ROOT/share/nemote/licenses/nemo/text-processing-LICENSE"
  cp -a "$NEMO_BUILD/deps/itn/lib/"*.so* "$STAGE_ROOT/lib/nemo/"
  cp -a "$NEMO_BUILD/deps/itn/share/licenses/" "$STAGE_ROOT/share/nemote/licenses/nemo/itn"
  cp -a "$NEMO_BUILD/deps/sentencepiece/share/licenses/" "$STAGE_ROOT/share/nemote/licenses/nemo/sentencepiece"
  install -m 0644 /usr/share/doc/libprotobuf32/copyright "$STAGE_ROOT/share/nemote/licenses/nemo/protobuf-copyright"
  install -m 0644 /usr/share/doc/libre2-9/copyright "$STAGE_ROOT/share/nemote/licenses/nemo/re2-copyright"
  install -m 0644 /usr/share/doc/zlib1g/copyright "$STAGE_ROOT/share/nemote/licenses/nemo/zlib-copyright"
  # Bundle the normalizer's system dependencies as well. Their SONAMEs are
  # stable, and $ORIGIN keeps transitive dependencies inside the release.
  while read -r task_library; do
    [[ -f "$task_library" ]] || { echo "Missing ITN dependency: $task_library" >&2; exit 1; }
    cp -L "$task_library" "$STAGE_ROOT/lib/nemo/$(basename "$task_library")"
  done < <(ldd "$NEMO_BUILD/bin/libnemo_speech_asr.so" | awk '/libprotobuf|libre2|libz\.so/ {print $3}')
  for task_library in "$STAGE_ROOT/lib/nemo/"*.so*; do
    [[ -L "$task_library" ]] || patchelf --set-rpath '$ORIGIN' "$task_library"
  done
fi
# The reproducible Debian build links the system SentencePiece shared library.
# Bundle it as well: users must not need development packages to run the worker.
task_sentencepiece=$(ldd "$NEMO_BUILD/bin/libnemo_speech_asr.so" | awk '/libsentencepiece\.so/ {print $3}')
if [[ -n "$task_sentencepiece" ]]; then
  if [[ "$task_sentencepiece" != /* || ! -f "$task_sentencepiece" ]]; then
    echo "SentencePiece runtime dependency is missing" >&2
    exit 1
  fi
  cp -L "$task_sentencepiece" "$STAGE_ROOT/lib/nemo/$(basename "$task_sentencepiece")"
  install -m 0644 /usr/share/doc/libsentencepiece0/copyright \
    "$STAGE_ROOT/share/nemote/licenses/nemo/sentencepiece-copyright"
fi
install -m 0644 "$NEMO_SOURCE/LICENSE" "$STAGE_ROOT/share/nemote/licenses/nemo/LICENSE"
install -m 0644 "$NEMO_SOURCE/NOTICE" "$STAGE_ROOT/share/nemote/licenses/nemo/NOTICE"
install -m 0644 "$NEMO_SOURCE/THIRD_PARTY_NOTICES.md" "$STAGE_ROOT/share/nemote/licenses/nemo/THIRD_PARTY_NOTICES.md"
install -m 0644 "$NEMO_SOURCE/llama.cpp/LICENSE" "$STAGE_ROOT/share/nemote/licenses/nemo/llama-LICENSE"
install -m 0644 "$NEMO_SOURCE/third_party/miniaudio/LICENSE" "$STAGE_ROOT/share/nemote/licenses/nemo/miniaudio-LICENSE"
install -m 0644 "$NEMO_SOURCE/ggml/LICENSE" "$STAGE_ROOT/share/nemote/licenses/nemo/ggml-LICENSE"
install -m 0644 "$NEMO_SOURCE/llama.cpp/licenses/LICENSE-jsonhpp" "$STAGE_ROOT/share/nemote/licenses/nemo/json-LICENSE"
cp -a "$ROOT/src/nemote" "$STAGE_ROOT/lib/python/nemote"
find "$STAGE_ROOT/lib/python/nemote" -type d -name __pycache__ -prune -exec rm -rf {} +
find "$STAGE_ROOT/lib/python/nemote" -type f -name '*.pyc' -delete
cat > "$STAGE_ROOT/bin/nemote-model-install" <<'EOF'
#!/usr/bin/env sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PREFIX=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
PYTHON="${NEMOTE_PYTHON:-python3}"
export PYTHONPATH="$PREFIX/lib/python${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m nemote model-install "$@"
EOF
chmod 0755 "$STAGE_ROOT/bin/nemote-model-install"

cat > "$STAGE_ROOT/share/dbus-1/services/dev.nemote.Service.service" <<'EOF'
[D-BUS Service]
Name=dev.nemote.Service
Exec=@NEMOTE_LIBEXEC@/bin/nemote-service
SystemdService=nemote-service.service
EOF

cat > "$STAGE_ROOT/share/systemd/user/nemote-service.service" <<'EOF'
[Unit]
Description=NeMote dictation service
Documentation=https://github.com/danhansen/nemote

[Service]
Type=dbus
BusName=dev.nemote.Service
ExecStart=@NEMOTE_LIBEXEC@/bin/nemote-service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF

copy_extension "$STAGE_ROOT/share/gnome-shell/extensions/$UUID"
glib-compile-schemas "$STAGE_ROOT/share/gnome-shell/extensions/$UUID/schemas"

cat > "$STAGE_ROOT/README.release" <<EOF
NeMote ${VERSION}

Run ./install.sh from this extracted directory to install the GNOME Shell
extension, native D-Bus service, ASR worker, and model-download helper into your
user account.
EOF

cat > "$STAGE_ROOT/install.sh" <<'EOF'
#!/usr/bin/env sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$SELF_DIR/share/nemote/install-nemote-release" --from-extracted "$SELF_DIR" "$@"
EOF
chmod 0755 "$STAGE_ROOT/install.sh"

install -m 0755 "$ROOT/scripts/install-nemote-release" \
  "$STAGE_ROOT/share/nemote/install-nemote-release"

copy_extension "$EXTENSION_WORK"
glib-compile-schemas "$EXTENSION_WORK/schemas"
rm -f "$EXTENSION_ZIP"
(cd "$EXTENSION_WORK" && zip -qr "$EXTENSION_ZIP" .)

rm -f "$COMPOSED_ARCHIVE" "$VERSIONED_ARCHIVE"
(cd "$WORK_DIR" && tar -czf "$COMPOSED_ARCHIVE" "nemote-${VERSION}-linux-${ARCH}")
cp "$COMPOSED_ARCHIVE" "$VERSIONED_ARCHIVE"

if command -v sha256sum >/dev/null 2>&1; then
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$COMPOSED_ARCHIVE")" > "$(basename "$COMPOSED_ARCHIVE").sha256")
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$VERSIONED_ARCHIVE")" > "$(basename "$VERSIONED_ARCHIVE").sha256")
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$EXTENSION_ZIP")" > "$(basename "$EXTENSION_ZIP").sha256")
fi

echo "wrote $COMPOSED_ARCHIVE"
echo "wrote $VERSIONED_ARCHIVE"
echo "wrote $EXTENSION_ZIP"
