#!/usr/bin/env sh
set -eu

REPO="${NEMOTE_GITHUB_REPO:-danhansen/nemote}"
VERSION="${NEMOTE_VERSION:-latest}"
ARCH="$(uname -m)"
UUID="nemote@dhansen.dev"
SERVICE_NAME="dev.nemote.Service"
ARCHIVE_NAME="nemote-linux-${ARCH}.tar.gz"

FROM_EXTRACTED=""

usage() {
  cat <<'EOF'
Usage: install-nemote-release [--from-extracted DIR]

Install NeMote's GNOME Shell extension plus the native D-Bus service into the
current user account. By default this downloads the latest GitHub Release
archive from $NEMOTE_GITHUB_REPO.

Environment:
  NEMOTE_GITHUB_REPO       GitHub repo, default danhansen/nemote
  NEMOTE_VERSION           Release tag, default latest
  NEMOTE_LIBEXEC_DIR       Binary installation directory (default ~/.local/libexec/nemote)
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --from-extracted)
      FROM_EXTRACTED="${2:?missing --from-extracted value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

need_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "nemote install error: missing required tool: $1" >&2
    exit 1
  fi
}

download_release() {
  need_tool curl
  need_tool tar

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/nemote-install.XXXXXX")"
  archive="$tmp_dir/$ARCHIVE_NAME"
  checksum="$archive.sha256"

  if [ "$VERSION" = "latest" ]; then
    base_url="https://github.com/$REPO/releases/latest/download"
  else
    base_url="https://github.com/$REPO/releases/download/$VERSION"
  fi

  echo "Downloading $base_url/$ARCHIVE_NAME" >&2
  curl -fsSL "$base_url/$ARCHIVE_NAME" -o "$archive"
  if curl -fsSL "$base_url/$ARCHIVE_NAME.sha256" -o "$checksum"; then
    if command -v sha256sum >/dev/null 2>&1; then
      (cd "$tmp_dir" && sha256sum -c "$(basename "$checksum")") >&2
    else
      echo "sha256sum not available; skipping checksum verification" >&2
    fi
  else
    echo "checksum not available; continuing without verification" >&2
  fi

  mkdir -p "$tmp_dir/extract"
  tar -xzf "$archive" -C "$tmp_dir/extract"
  find "$tmp_dir/extract" -mindepth 1 -maxdepth 1 -type d | head -n 1
}

if [ -n "$FROM_EXTRACTED" ]; then
  PACKAGE_DIR="$FROM_EXTRACTED"
else
  PACKAGE_DIR="$(download_release)"
fi

if [ ! -x "$PACKAGE_DIR/bin/nemote-service" ]; then
  echo "nemote install error: invalid package directory: $PACKAGE_DIR" >&2
  exit 1
fi

need_tool python3
python3 -c 'import sys; assert sys.version_info >= (3, 11), "NeMote requires Python 3.11 or newer"'

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
LIBEXEC_DIR="${NEMOTE_LIBEXEC_DIR:-$HOME/.local/libexec/nemote}"
EXTENSION_DIR="$DATA_HOME/gnome-shell/extensions/$UUID"
DBUS_SERVICE_DIR="$DATA_HOME/dbus-1/services"
SYSTEMD_USER_DIR="$CONFIG_HOME/systemd/user"

# Migrate the old installation without deleting settings, models, or binaries.
# Retired activation files are moved aside so both services cannot auto-start.
if command -v gnome-extensions >/dev/null 2>&1; then
  gnome-extensions disable wordpipe@dhansen.dev >/dev/null 2>&1 || true
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user stop wordpipe-service.service >/dev/null 2>&1 || true
  systemctl --user list-units --all --plain --no-legend 'dbus-*dev.wordpipe.Service*.service' 2>/dev/null |
    while read -r unit rest; do
      [ -n "$unit" ] || continue
      systemctl --user stop "$unit" || true
    done
fi
for legacy_file in "$DBUS_SERVICE_DIR/dev.wordpipe.Service.service" "$SYSTEMD_USER_DIR/wordpipe-service.service"; do
  if [ -f "$legacy_file" ]; then
    # mktemp ensures repeated installs cannot overwrite an earlier backup.
    backup_file="$(mktemp "${legacy_file}.retired.XXXXXX")"
    mv "$legacy_file" "$backup_file"
    echo "Preserved retired activation file: $backup_file"
  fi
done
if [ ! -e "$CONFIG_HOME/nemote/service.json" ] && [ -f "$CONFIG_HOME/wordpipe/service.json" ]; then
  mkdir -p "$CONFIG_HOME/nemote"
  cp -p "$CONFIG_HOME/wordpipe/service.json" "$CONFIG_HOME/nemote/service.json"
fi
if [ ! -e "$DATA_HOME/nemote/models" ] && [ ! -L "$DATA_HOME/nemote/models" ] && [ -d "$DATA_HOME/wordpipe/models" ]; then
  mkdir -p "$DATA_HOME/nemote"
  ln -s "$DATA_HOME/wordpipe/models" "$DATA_HOME/nemote/models"
fi

echo "Installing NeMote binaries"
mkdir -p "$LIBEXEC_DIR"
rm -rf "$LIBEXEC_DIR/bin" "$LIBEXEC_DIR/lib" "$LIBEXEC_DIR/share"
cp -a "$PACKAGE_DIR/bin" "$LIBEXEC_DIR/bin"
cp -a "$PACKAGE_DIR/lib" "$LIBEXEC_DIR/lib"
cp -a "$PACKAGE_DIR/share" "$LIBEXEC_DIR/share"

# Downloads use only the standard library: no venv, pip or ONNX packages.

echo "Installing D-Bus activation service"
mkdir -p "$DBUS_SERVICE_DIR"
sed "s|@NEMOTE_LIBEXEC@|$LIBEXEC_DIR|g" \
  "$PACKAGE_DIR/share/dbus-1/services/$SERVICE_NAME.service" \
  > "$DBUS_SERVICE_DIR/$SERVICE_NAME.service"

echo "Installing systemd user unit"
mkdir -p "$SYSTEMD_USER_DIR"
sed "s|@NEMOTE_LIBEXEC@|$LIBEXEC_DIR|g" \
  "$PACKAGE_DIR/share/systemd/user/nemote-service.service" \
  > "$SYSTEMD_USER_DIR/nemote-service.service"
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
  systemctl --user list-units --all --plain --no-legend 'dbus-*dev.nemote.Service*.service' 2>/dev/null |
    while read -r unit rest; do
      [ -n "$unit" ] || continue
      systemctl --user stop "$unit" || true
    done
  systemctl --user restart nemote-service.service || true
fi

echo "Installing GNOME Shell extension"
extension_upgrade=0
if [ -d "$EXTENSION_DIR" ]; then
  extension_upgrade=1
fi
tmp_extension="${EXTENSION_DIR}.tmp.$$"
rm -rf "$tmp_extension"
mkdir -p "$(dirname "$EXTENSION_DIR")"
cp -a "$PACKAGE_DIR/share/gnome-shell/extensions/$UUID" "$tmp_extension"
if command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas "$tmp_extension/schemas"
fi
rm -rf "$EXTENSION_DIR"
mv "$tmp_extension" "$EXTENSION_DIR"

if command -v dconf >/dev/null 2>&1; then
  # Preserve user preferences, but don't replace preferences already set in NeMote.
  current_settings="$(dconf dump /org/gnome/shell/extensions/nemote/)"
  if [ -z "$current_settings" ]; then
    dconf dump /org/gnome/shell/extensions/wordpipe/ |
      dconf load /org/gnome/shell/extensions/nemote/
    # Only retired executable names are reset; custom executables remain intact.
    case "$(dconf read /org/gnome/shell/extensions/nemote/worker-path)" in
      *"/wordpipe-nemo-worker'"|*"/wordpipe-parakeet-worker'")
        dconf reset /org/gnome/shell/extensions/nemote/worker-path ;;
    esac
    case "$(dconf read /org/gnome/shell/extensions/nemote/model-installer-path)" in
      *"/wordpipe-model-install'")
        dconf reset /org/gnome/shell/extensions/nemote/model-installer-path ;;
    esac
    dconf reset /org/gnome/shell/extensions/nemote/shortcut-capture-active
  fi
else
  echo "dconf is unavailable; GNOME preferences use defaults. Service settings and models are preserved."
fi
if [ -d "$DATA_HOME/gnome-shell/extensions/wordpipe@dhansen.dev" ]; then
  echo "The old extension is disabled. Log out and back in before enabling NeMote."
fi

if command -v gnome-extensions >/dev/null 2>&1; then
  if gnome-extensions info "$UUID" >/dev/null 2>&1; then
    gnome-extensions enable "$UUID" || true
  else
    echo "GNOME Shell has not discovered $UUID yet; log out and back in, then enable it."
  fi
fi

if [ "$extension_upgrade" = "1" ]; then
  echo "GNOME Shell caches loaded extension code. Log out and back in to activate this upgrade."
fi

echo "Installed NeMote"
echo "Open settings with: gnome-extensions prefs $UUID"
echo "Install a model with: $LIBEXEC_DIR/bin/nemote-model-install --model-family english"
