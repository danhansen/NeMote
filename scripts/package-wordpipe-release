#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/package-wordpipe-release [--version VERSION] [--output-dir DIR] [--skip-build]

Build the composed Wordpipe GitHub release archive and the source-only GNOME
Shell extension zip suitable for extensions.gnome.org review.
EOF
}

VERSION=""
OUTPUT_DIR=""
SKIP_BUILD=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      VERSION="${2:?missing --version value}"
      shift 2
      ;;
    --output-dir)
      OUTPUT_DIR="${2:?missing --output-dir value}"
      shift 2
      ;;
    --skip-build)
      SKIP_BUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUST_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
UUID="wordpipe@dhansen.dev"
ARCH="$(uname -m)"

if [[ -z "$VERSION" ]]; then
  if git -C "$ROOT" describe --tags --always --dirty >/dev/null 2>&1; then
    VERSION="$(git -C "$ROOT" describe --tags --always --dirty)"
  else
    VERSION="dev"
  fi
fi

if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR="$ROOT/build/release"
fi
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR="$(cd "$OUTPUT_DIR" && pwd)"

WORK_DIR="$ROOT/build/release-work"
STAGE_ROOT="$WORK_DIR/wordpipe-${VERSION}-linux-${ARCH}"
EXTENSION_WORK="$WORK_DIR/${UUID}"
COMPOSED_ARCHIVE="$OUTPUT_DIR/wordpipe-linux-${ARCH}.tar.gz"
VERSIONED_ARCHIVE="$OUTPUT_DIR/wordpipe-${VERSION}-linux-${ARCH}.tar.gz"
EXTENSION_ZIP="$OUTPUT_DIR/${UUID}.shell-extension.zip"

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required tool: $1" >&2
    exit 1
  fi
}

copy_extension() {
  local destination="$1"
  rm -rf "$destination"
  mkdir -p "$(dirname "$destination")"
  cp -a "$ROOT/extensions/gnome-shell/$UUID" "$destination"
  rm -f "$destination/schemas/gschemas.compiled"
}

require_tool cargo
require_tool glib-compile-schemas
require_tool tar
require_tool zip

if [[ "$SKIP_BUILD" -eq 0 ]]; then
  cargo build --release \
    --manifest-path "$ROOT/Cargo.toml" \
    -p wordpipe-service \
    -p wordpipe-parakeet-worker
  bash "$ROOT/scripts/build-nemo-worker"
fi

rm -rf "$WORK_DIR"
mkdir -p \
  "$STAGE_ROOT/bin" \
  "$STAGE_ROOT/lib/python" \
  "$STAGE_ROOT/share/wordpipe/scripts" \
  "$STAGE_ROOT/share/wordpipe" \
  "$STAGE_ROOT/share/dbus-1/services" \
  "$STAGE_ROOT/share/systemd/user" \
  "$STAGE_ROOT/share/gnome-shell/extensions"

install -m 0755 "$RUST_TARGET_DIR/release/wordpipe-service" "$STAGE_ROOT/bin/wordpipe-service"
install -m 0755 "$RUST_TARGET_DIR/release/wordpipe-parakeet-worker" "$STAGE_ROOT/bin/wordpipe-parakeet-worker"
NEMO_WORKER_BUILD="${WORDPIPE_NEMO_WORKER_BUILD:-$ROOT/build/nemo-worker}"
NEMO_SOURCE="${WORDPIPE_NEMO_SOURCE:-$ROOT/build/nemo-speech-cpp}"
NEMO_BUILD="${WORDPIPE_NEMO_BUILD:-$NEMO_SOURCE/build/wordpipe-cpu}"
cmake --install "$NEMO_WORKER_BUILD" --prefix "$STAGE_ROOT"
mkdir -p "$STAGE_ROOT/lib/nemo" "$STAGE_ROOT/share/wordpipe/licenses/nemo"
cp -a "$NEMO_BUILD/bin/"*.so* "$STAGE_ROOT/lib/nemo/"
if [[ "${WORDPIPE_NEMO_ITN:-ON}" == ON ]]; then
  require_tool patchelf
  cp -a "$NEMO_BUILD/deps/itn_configs" "$STAGE_ROOT/share/wordpipe/itn"
  install -m 0644 "$NEMO_BUILD/deps/text-processing/LICENSE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/text-processing-LICENSE"
  cp -a "$NEMO_BUILD/deps/itn/lib/"*.so* "$STAGE_ROOT/lib/nemo/"
  cp -a "$NEMO_BUILD/deps/itn/share/licenses/" "$STAGE_ROOT/share/wordpipe/licenses/nemo/itn"
  cp -a "$NEMO_BUILD/deps/sentencepiece/share/licenses/" "$STAGE_ROOT/share/wordpipe/licenses/nemo/sentencepiece"
  install -m 0644 /usr/share/doc/libprotobuf32/copyright "$STAGE_ROOT/share/wordpipe/licenses/nemo/protobuf-copyright"
  install -m 0644 /usr/share/doc/libre2-9/copyright "$STAGE_ROOT/share/wordpipe/licenses/nemo/re2-copyright"
  install -m 0644 /usr/share/doc/zlib1g/copyright "$STAGE_ROOT/share/wordpipe/licenses/nemo/zlib-copyright"
  # Bundle the normalizer's system dependencies as well. Their SONAMEs are
  # stable, and $ORIGIN keeps transitive dependencies inside the release.
  while read -r task_library; do
    [[ -f "$task_library" ]] || { echo "Missing ITN dependency: $task_library" >&2; exit 1; }
    cp -L "$task_library" "$STAGE_ROOT/lib/nemo/$(basename "$task_library")"
  done < <(ldd "$NEMO_BUILD/bin/libnemo_speech_asr.so" | awk '/libprotobuf|libre2|libz\.so/ {print $3}')
  for task_library in "$STAGE_ROOT/lib/nemo/"*.so*; do
    [[ -L "$task_library" ]] || patchelf --set-rpath '$ORIGIN' "$task_library"
  done
fi
# The reproducible Debian build links the system SentencePiece shared library.
# Bundle it as well: users must not need development packages to run the worker.
task_sentencepiece=$(ldd "$NEMO_BUILD/bin/libnemo_speech_asr.so" | awk '/libsentencepiece\.so/ {print $3}')
if [[ -n "$task_sentencepiece" ]]; then
  if [[ "$task_sentencepiece" != /* || ! -f "$task_sentencepiece" ]]; then
    echo "SentencePiece runtime dependency is missing" >&2
    exit 1
  fi
  cp -L "$task_sentencepiece" "$STAGE_ROOT/lib/nemo/$(basename "$task_sentencepiece")"
  install -m 0644 /usr/share/doc/libsentencepiece0/copyright \
    "$STAGE_ROOT/share/wordpipe/licenses/nemo/sentencepiece-copyright"
fi
install -m 0644 "$NEMO_SOURCE/LICENSE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/LICENSE"
install -m 0644 "$NEMO_SOURCE/NOTICE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/NOTICE"
install -m 0644 "$NEMO_SOURCE/THIRD_PARTY_NOTICES.md" "$STAGE_ROOT/share/wordpipe/licenses/nemo/THIRD_PARTY_NOTICES.md"
install -m 0644 "$NEMO_SOURCE/llama.cpp/LICENSE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/llama-LICENSE"
install -m 0644 "$NEMO_SOURCE/third_party/miniaudio/LICENSE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/miniaudio-LICENSE"
install -m 0644 "$NEMO_SOURCE/ggml/LICENSE" "$STAGE_ROOT/share/wordpipe/licenses/nemo/ggml-LICENSE"
install -m 0644 "$NEMO_SOURCE/llama.cpp/licenses/LICENSE-jsonhpp" "$STAGE_ROOT/share/wordpipe/licenses/nemo/json-LICENSE"
install -m 0644 "$ROOT/packaging/requirements-release-model-install.txt" \
  "$STAGE_ROOT/share/wordpipe/requirements-model-install.txt"

cp -a "$ROOT/src/wordpipe" "$STAGE_ROOT/lib/python/wordpipe"
find "$STAGE_ROOT/lib/python/wordpipe" -type d -name __pycache__ -prune -exec rm -rf {} +
find "$STAGE_ROOT/lib/python/wordpipe" -type f -name '*.pyc' -delete
install -m 0755 "$ROOT/scripts/convert_nemotron_to_ort_format.py" \
  "$STAGE_ROOT/share/wordpipe/scripts/convert_nemotron_to_ort_format.py"
install -m 0755 "$ROOT/scripts/build_nemotron_wordpipe_model.py" \
  "$STAGE_ROOT/share/wordpipe/scripts/build_nemotron_wordpipe_model.py"
for task_model_script in export_nemotron_parakeet_optimized.py transform_nemotron_parakeet_export.py \
    rewrite_nemotron_projected_kv_cache.py rewrite_nemotron_pointwise_convs.py build_nemotron_fixed_shape_model.py \
    build_nemotron_dynamic_shape_model.py nemotron_dynamic_encoder.py \
    verify_dynamic_nemotron_export.py validate_dynamic_nemotron_release.py; do
  install -m 0755 "$ROOT/scripts/$task_model_script" "$STAGE_ROOT/share/wordpipe/scripts/$task_model_script"
done
install -m 0755 "$ROOT/scripts/download_hf_ranged.py" \
  "$STAGE_ROOT/share/wordpipe/scripts/download_hf_ranged.py"
install -m 0755 "$ROOT/scripts/bundle_nemotron_streaming_modes.py" \
  "$STAGE_ROOT/share/wordpipe/scripts/bundle_nemotron_streaming_modes.py"

cat > "$STAGE_ROOT/bin/wordpipe-model-install" <<'EOF'
#!/usr/bin/env sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PREFIX=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
PYTHON="$PREFIX/python-venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON="${WORDPIPE_PYTHON:-python3}"
fi
export PYTHONPATH="$PREFIX/lib/python${PYTHONPATH:+:$PYTHONPATH}"
export WORDPIPE_SCRIPTS_DIR="$PREFIX/share/wordpipe/scripts"
exec "$PYTHON" -m wordpipe model-install "$@"
EOF
chmod 0755 "$STAGE_ROOT/bin/wordpipe-model-install"

cat > "$STAGE_ROOT/share/dbus-1/services/dev.wordpipe.Service.service" <<'EOF'
[D-BUS Service]
Name=dev.wordpipe.Service
Exec=@WORDPIPE_LIBEXEC@/bin/wordpipe-service
SystemdService=wordpipe-service.service
EOF

cat > "$STAGE_ROOT/share/systemd/user/wordpipe-service.service" <<'EOF'
[Unit]
Description=Wordpipe Rust dictation service
Documentation=https://github.com/danhansen/wordpipe

[Service]
Type=dbus
BusName=dev.wordpipe.Service
ExecStart=@WORDPIPE_LIBEXEC@/bin/wordpipe-service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF

copy_extension "$STAGE_ROOT/share/gnome-shell/extensions/$UUID"
glib-compile-schemas "$STAGE_ROOT/share/gnome-shell/extensions/$UUID/schemas"

cat > "$STAGE_ROOT/README.release" <<EOF
Wordpipe ${VERSION}

Run ./install.sh from this extracted directory to install the GNOME Shell
extension, Rust D-Bus service, ASR worker, and model-install helper into your
user account.
EOF

cat > "$STAGE_ROOT/install.sh" <<'EOF'
#!/usr/bin/env sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$SELF_DIR/share/wordpipe/install-wordpipe-release" --from-extracted "$SELF_DIR" "$@"
EOF
chmod 0755 "$STAGE_ROOT/install.sh"

install -m 0755 "$ROOT/scripts/install-wordpipe-release" \
  "$STAGE_ROOT/share/wordpipe/install-wordpipe-release"

copy_extension "$EXTENSION_WORK"
glib-compile-schemas "$EXTENSION_WORK/schemas"
rm -f "$EXTENSION_ZIP"
(cd "$EXTENSION_WORK" && zip -qr "$EXTENSION_ZIP" .)

rm -f "$COMPOSED_ARCHIVE" "$VERSIONED_ARCHIVE"
(cd "$WORK_DIR" && tar -czf "$COMPOSED_ARCHIVE" "wordpipe-${VERSION}-linux-${ARCH}")
cp "$COMPOSED_ARCHIVE" "$VERSIONED_ARCHIVE"

if command -v sha256sum >/dev/null 2>&1; then
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$COMPOSED_ARCHIVE")" > "$(basename "$COMPOSED_ARCHIVE").sha256")
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$VERSIONED_ARCHIVE")" > "$(basename "$VERSIONED_ARCHIVE").sha256")
  (cd "$OUTPUT_DIR" && sha256sum "$(basename "$EXTENSION_ZIP")" > "$(basename "$EXTENSION_ZIP").sha256")
fi

echo "wrote $COMPOSED_ARCHIVE"
echo "wrote $VERSIONED_ARCHIVE"
echo "wrote $EXTENSION_ZIP"
