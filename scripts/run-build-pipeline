#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

run_tests() {
  bash scripts/build-nemo-worker
  bash scripts/build-service
  ctest --test-dir "${WORDPIPE_SERVICE_BUILD:-$ROOT/build/service}" --output-on-failure
  ctest --test-dir "${WORDPIPE_NEMO_WORKER_BUILD:-$ROOT/build/nemo-worker}" --output-on-failure
  dbus-run-session -- env WORDPIPE_TEST_BUS=1 python3 scripts/check_service_lifecycle.py --service "${WORDPIPE_SERVICE_BUILD:-$ROOT/build/service}/wordpipe-service"
  PYTHONPATH=src python3 -m unittest discover -s tests
  python3 scripts/check_gnome_dbus_xml.py
  sh -n scripts/install-wordpipe-release
  node --input-type=module --check \
    < extensions/gnome-shell/wordpipe@dhansen.dev/extension.js
  node --input-type=module --check \
    < extensions/gnome-shell/wordpipe@dhansen.dev/prefs.js
  node --test tests/test_shortcut_state.mjs tests/test_model_state.mjs tests/test_service_lifecycle.mjs tests/test_preferences_refresh.mjs tests/test_text_insertion.mjs
  glib-compile-schemas --strict --dry-run \
    extensions/gnome-shell/wordpipe@dhansen.dev/schemas
}

package_release() {
  local version=${1:?package requires a version}
  local output_dir=${2:-dist}
  scripts/package-wordpipe-release --version "$version" --output-dir "$output_dir"
}

case "${1:-test}" in
  test)
    run_tests
    ;;
  package)
    package_release "${2:-}" "${3:-dist}"
    ;;
  all)
    run_tests
    package_release "${2:-}" "${3:-dist}"
    ;;
  *)
    echo "usage: scripts/run-build-pipeline test|package VERSION [OUTPUT_DIR]|all VERSION [OUTPUT_DIR]" >&2
    exit 2
    ;;
esac
