#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SOURCE=${NEMOTE_NEMO_SOURCE:-$ROOT/build/nemo-speech-cpp}
BUILD=${NEMOTE_SERVICE_BUILD:-$ROOT/build/nemote-service}
cmake -S "$ROOT/native/nemote-service" -B "$BUILD" \
  -DCMAKE_BUILD_TYPE=Release -DNEMO_SPEECH_SOURCE_DIR="$SOURCE"
cmake --build "$BUILD" -j "${NEMOTE_BUILD_JOBS:-2}"
