# docker.io/library/debian:bookworm-slim
FROM docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        ca-certificates \
        cmake \
        dbus \
        g++ \
        git \
        libasound2-dev \
        libglib2.0-bin \
        libglib2.0-dev \
        libsentencepiece-dev \
        libprotobuf-dev \
        libre2-dev \
        libtool \
        make \
        nodejs \
        ninja-build \
        patchelf \
        pkg-config \
        python3 \
        python3-dev \
        python3-gi \
        python3-pip \
        python3-venv \
        protobuf-compiler \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/wordpipe-venv
COPY containers/requirements-dev.lock /tmp/wordpipe-requirements-dev.lock
RUN /opt/wordpipe-venv/bin/python -m pip install --no-cache-dir \
        -r /tmp/wordpipe-requirements-dev.lock \
    && rm /tmp/wordpipe-requirements-dev.lock

COPY containers/entrypoint.sh /usr/local/bin/wordpipe-container-entrypoint
RUN chmod 0755 /usr/local/bin/wordpipe-container-entrypoint

ENV PATH="/opt/wordpipe-venv/bin:${PATH}" \
    PYTHONPATH="/workspace/src" \
    XDG_CONFIG_HOME="/tmp/wordpipe-config" \
    XDG_DATA_HOME="/tmp/wordpipe-data" \
    XDG_CACHE_HOME="/tmp/wordpipe-cache"

WORKDIR /workspace
ENTRYPOINT ["wordpipe-container-entrypoint"]
CMD ["scripts/run-build-pipeline", "test"]
