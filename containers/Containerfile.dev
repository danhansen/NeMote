# docker.io/library/debian:bookworm-slim
FROM docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

ARG DEBIAN_FRONTEND=noninteractive
ARG NEMOTE_DEV_UID=1000
ARG NEMOTE_DEV_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        ca-certificates \
        cmake \
        dbus \
        g++ \
        git \
        libasound2-dev \
        libglib2.0-bin \
        libglib2.0-dev \
        libsentencepiece-dev \
        libprotobuf-dev \
        libre2-dev \
        libtool \
        make \
        nodejs \
        ninja-build \
        patchelf \
        pkg-config \
        python3 \
        python3-dev \
        python3-gi \
        python3-pip \
        python3-venv \
        protobuf-compiler \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Docker's --user UID:GID doesn't create a passwd entry. The private D-Bus
# daemon requires one; Podman keep-id normally supplies it and hid this failure.
RUN if ! getent group "$NEMOTE_DEV_GID" >/dev/null; then \
        groupadd --gid "$NEMOTE_DEV_GID" nemote-dev; \
    fi \
    && if ! getent passwd "$NEMOTE_DEV_UID" >/dev/null; then \
        useradd --uid "$NEMOTE_DEV_UID" --gid "$NEMOTE_DEV_GID" \
            --create-home --shell /bin/bash nemote-dev; \
    fi

RUN python3 -m venv --system-site-packages /opt/nemote-venv
COPY containers/requirements-dev.lock /tmp/nemote-requirements-dev.lock
RUN /opt/nemote-venv/bin/python -m pip install --no-cache-dir \
        -r /tmp/nemote-requirements-dev.lock \
    && rm /tmp/nemote-requirements-dev.lock

COPY containers/entrypoint.sh /usr/local/bin/nemote-container-entrypoint
RUN chmod 0755 /usr/local/bin/nemote-container-entrypoint

ENV PATH="/opt/nemote-venv/bin:${PATH}" \
    PYTHONPATH="/workspace/src" \
    XDG_CONFIG_HOME="/tmp/nemote-config" \
    XDG_DATA_HOME="/tmp/nemote-data" \
    XDG_CACHE_HOME="/tmp/nemote-cache"

WORKDIR /workspace
USER ${NEMOTE_DEV_UID}:${NEMOTE_DEV_GID}
ENTRYPOINT ["nemote-container-entrypoint"]
CMD ["scripts/run-build-pipeline", "test"]
