@@ -1331,2 +1331,19 @@
 void
+AsrModel::load_boost_tokenizer(const std::string& path) {
+    if (spm_) return;
+    auto sp = std::make_unique<sentencepiece::SentencePieceProcessor>();
+    const auto status = sp->Load(path);
+    if (!status.ok()) throw std::runtime_error("Cannot load boosting tokenizer: " + status.ToString());
+    const auto count = static_cast<size_t>(sp->GetPieceSize());
+    if (vocab_.size() < count || vocab_.size() > count + 1)
+        throw std::runtime_error("Boosting tokenizer does not match ASR vocabulary size");
+    for (size_t i = 0; i < count; ++i) {
+        if (sp->IdToPiece(static_cast<int>(i)) != vocab_[i])
+            throw std::runtime_error("Boosting tokenizer does not match ASR token IDs");
+    }
+    spm_ = std::move(sp);
+    GGMLF_LOG_INFO("[asr_model] matching sidecar tokenizer loaded for word boosting\n");
+}
