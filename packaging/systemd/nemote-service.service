[Unit]
Description=NeMote dictation service
Documentation=https://github.com/danhansen/NeMote
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=dev.nemote.Service
ExecStart=@NEMOTE_LIBEXEC@/bin/nemote-service
Restart=on-failure
RestartSec=2
KillMode=control-group

[Install]
WantedBy=default.target
